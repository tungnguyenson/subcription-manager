<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Chi de sao luu, khong phai de dong bo hai chieu. App ghi mot tep JSON vao
	  container nay sau moi thay doi; khong co gi doc nguoc lai tru luc khoi phuc.

	  Can thiet vi ban sao luu ca may cua iOS khong cho lay lai rieng mot app:
	  du lieu nam trong do nhung muon lay ra phai khoi phuc toan bo dien thoai.
	  Mot tep rieng trong container nay thi lay lai duoc mot minh no.
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.space.subdock.subdock</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.space.subdock.subdock</string>
	</array>
</dict>
</plist>
