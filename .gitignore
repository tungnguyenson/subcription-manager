# Dart / Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
pubspec.lock.bak

# Mã sinh tự động.
#
# Cố tình không commit. Một tệp .g.dart cũ nằm cạnh lược đồ đã sửa là lỗi âm
# thầm: nó vẫn biên dịch, vẫn chạy, và ánh xạ sai cột. Thiếu hẳn tệp thì báo
# lỗi ngay lúc biên dịch, ai cũng thấy. Chạy `dart run build_runner build`
# sau khi clone hoặc sau khi sửa `lib/data/tables.drift`.
*.g.dart

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
**/xcuserdata/
*.xcworkspace/xcuserdata/

# Editor
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# Golden debug output, rewritten on every failing run.
test/golden/failures/

# Bytecode của các script trong tool/. Sinh ra chỉ vì merge_services.py import
# validate_services.py, nên nó xuất hiện sau mỗi lần kiểm dữ liệu danh mục.
__pycache__/
*.pyc

# Screenshots from tool/shots/capture.dart. Regenerated on demand and dated
# from the clock, so they are never a fixed artefact to compare against.
tool/shots/out/

# Khoa OAuth tai ve tu Google Cloud Console.
#
# App nay khong dung toi client secret: google_sign_in tren dien thoai chi can
# client id, va client id thi khong phai bi mat, no nam san trong moi ban app da
# phat hanh. File secret tai ve chi de o may, khong duoc vao repo.
credentials/
client_secret_*.json
