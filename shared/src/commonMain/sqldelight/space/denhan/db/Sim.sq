-- A SIM carries state that "a name and a date" cannot express, because three
-- independent clocks can each end a number and topping up defends against only
-- one of them. See product-spec.md section 4bis.1.

CREATE TABLE simProfileRow (
    groupId              TEXT NOT NULL PRIMARY KEY REFERENCES itemGroupRow(id) ON DELETE CASCADE,
    carrier              TEXT NOT NULL,
    msisdn               TEXT NOT NULL,
    isDormant            INTEGER NOT NULL DEFAULT 0,

    -- Clock 1: validity. Store what the carrier said and when, never a guess.
    hsdConfirmedDate     TEXT,
    hsdConfirmedAt       TEXT,

    -- Clock 2: identity re-authentication. Invisible to the app; user-attested.
    -- Defaults to UNKNOWN, never YES.
    identityVerified     TEXT NOT NULL DEFAULT 'UNKNOWN',
    identityCheckedAt    TEXT,

    -- Clock 3: handset change.
    lastDeviceChangeAt   TEXT,

    retentionPackage     TEXT,
    retentionExpiryDate  TEXT
);

selectAllSims:
SELECT * FROM simProfileRow;

selectSim:
SELECT * FROM simProfileRow WHERE groupId = ?;

selectDormantUnverified:
SELECT * FROM simProfileRow WHERE isDormant = 1 AND identityVerified != 'YES';

upsertSim:
INSERT OR REPLACE INTO simProfileRow(
    groupId, carrier, msisdn, isDormant,
    hsdConfirmedDate, hsdConfirmedAt,
    identityVerified, identityCheckedAt,
    lastDeviceChangeAt,
    retentionPackage, retentionExpiryDate
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

recordHsd:
UPDATE simProfileRow SET hsdConfirmedDate = ?, hsdConfirmedAt = ? WHERE groupId = ?;

recordIdentity:
UPDATE simProfileRow SET identityVerified = ?, identityCheckedAt = ? WHERE groupId = ?;

recordDeviceChange:
UPDATE simProfileRow SET lastDeviceChangeAt = ? WHERE groupId = ?;

deleteSim:
DELETE FROM simProfileRow WHERE groupId = ?;
