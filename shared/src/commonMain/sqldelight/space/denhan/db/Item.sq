-- Dates are ISO-8601 TEXT so the file stays readable from Swift (the widget
-- target reads this same SQLite file out of the App Group container) and from a
-- plain sqlite3 shell during debugging.
--
-- Money is INTEGER minor units. Never REAL. See product-spec.md section 6.2.

CREATE TABLE itemGroupRow (
    id          TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,
    kind        TEXT NOT NULL
);

CREATE TABLE itemRow (
    id                TEXT NOT NULL PRIMARY KEY,
    name              TEXT NOT NULL,
    groupId           TEXT REFERENCES itemGroupRow(id) ON DELETE SET NULL,
    kind              TEXT NOT NULL,
    stake             TEXT NOT NULL,
    categoryId        TEXT,

    expiresOn         TEXT NOT NULL,
    actByOffsetDays   INTEGER NOT NULL DEFAULT 0,
    anchorDate        TEXT NOT NULL,
    cycle             TEXT,

    amountMinor       INTEGER,
    currency          TEXT,

    actionUrl         TEXT,
    actionLabel       TEXT,
    note              TEXT,

    -- Comma-separated ints; a child table would buy nothing for a handful of values.
    leadDays          TEXT NOT NULL,
    remindAt          TEXT NOT NULL,
    nagAfterDue       TEXT NOT NULL,

    verifyEveryDays   INTEGER,
    lastVerifiedAt    TEXT,
    dateSource        TEXT NOT NULL,

    state             TEXT NOT NULL,
    createdAt         INTEGER NOT NULL
);

CREATE INDEX item_expiresOn ON itemRow(expiresOn);
CREATE INDEX item_state ON itemRow(state);
CREATE INDEX item_groupId ON itemRow(groupId);

selectAll:
SELECT * FROM itemRow ORDER BY expiresOn ASC;

selectActive:
SELECT * FROM itemRow WHERE state = 'ACTIVE' ORDER BY expiresOn ASC;

selectById:
SELECT * FROM itemRow WHERE id = ?;

selectByGroup:
SELECT * FROM itemRow WHERE groupId = ? ORDER BY expiresOn ASC;

upsert:
INSERT OR REPLACE INTO itemRow(
    id, name, groupId, kind, stake, categoryId,
    expiresOn, actByOffsetDays, anchorDate, cycle,
    amountMinor, currency,
    actionUrl, actionLabel, note,
    leadDays, remindAt, nagAfterDue,
    verifyEveryDays, lastVerifiedAt, dateSource,
    state, createdAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateState:
UPDATE itemRow SET state = ? WHERE id = ?;

updateExpiry:
UPDATE itemRow SET expiresOn = ?, dateSource = ? WHERE id = ?;

markVerified:
UPDATE itemRow SET lastVerifiedAt = ? WHERE id = ?;

deleteById:
DELETE FROM itemRow WHERE id = ?;

selectAllGroups:
SELECT * FROM itemGroupRow ORDER BY name ASC;

selectGroupById:
SELECT * FROM itemGroupRow WHERE id = ?;

upsertGroup:
INSERT OR REPLACE INTO itemGroupRow(id, name, kind) VALUES (?, ?, ?);

deleteGroup:
DELETE FROM itemGroupRow WHERE id = ?;
