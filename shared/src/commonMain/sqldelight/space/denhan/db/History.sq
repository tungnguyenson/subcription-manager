-- Append-only. A row here is a thing that already happened, so nothing in it is
-- ever updated except actualChargedMinor, which the user types off a bank
-- statement.
--
-- The FX rate is snapshotted per row and never recomputed. Wallos stores one
-- mutable rate per currency and overwrites it every six hours, so every
-- historical figure in that app changes four times a day; that is the single
-- largest cluster of bugs in the project. IAS 21 agrees: a settled foreign
-- currency expense is recorded at the rate on the transaction date and is not
-- retranslated. See product-spec.md section 6.3.

CREATE TABLE handledEventRow (
    id                   TEXT NOT NULL PRIMARY KEY,
    itemId               TEXT NOT NULL REFERENCES itemRow(id) ON DELETE CASCADE,
    handledAt            INTEGER NOT NULL,
    forDueDate           TEXT NOT NULL,

    amountMinor          INTEGER,
    currency             TEXT,

    fxRateScaled         INTEGER,
    fxRateScale          INTEGER,
    fxRateDate           TEXT,
    fxSource             TEXT,
    baseAmountMinor      INTEGER,

    -- Typed off a statement. Overrides every computed figure when present, and
    -- is the only way to capture the bank's foreign-currency fee (Vietcombank
    -- charges 2.27%, so a computed figure is structurally low).
    actualChargedMinor   INTEGER
);

CREATE INDEX handledEvent_itemId ON handledEventRow(itemId);
CREATE UNIQUE INDEX handledEvent_occurrence ON handledEventRow(itemId, forDueDate);

selectForItem:
SELECT * FROM handledEventRow WHERE itemId = ? ORDER BY forDueDate DESC;

selectOccurrence:
SELECT * FROM handledEventRow WHERE itemId = ? AND forDueDate = ?;

selectSince:
SELECT * FROM handledEventRow WHERE forDueDate >= ? ORDER BY forDueDate DESC;

insert:
INSERT OR REPLACE INTO handledEventRow(
    id, itemId, handledAt, forDueDate,
    amountMinor, currency,
    fxRateScaled, fxRateScale, fxRateDate, fxSource, baseAmountMinor,
    actualChargedMinor
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setActualCharged:
UPDATE handledEventRow SET actualChargedMinor = ? WHERE id = ?;

deleteForItem:
DELETE FROM handledEventRow WHERE itemId = ?;
