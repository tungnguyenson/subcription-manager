-- Dates are ISO-8601 TEXT so the file stays readable from Swift (the widget
-- target reads this same SQLite file out of the App Group container) and from a
-- plain sqlite3 shell during debugging.
--
-- Money is INTEGER minor units. Never REAL. See product-spec.md section 6.2.
--
-- Table names keep the `Row` suffix so the generated classes never collide with
-- the domain types they map to. The row and the model are genuinely different
-- shapes: the row stores enums as text and lead days as a joined string.

-- The `AS <Name>` clause pins the generated row class name. Without it the
-- name comes out of drift's singularisation rules, which would make an
-- unrelated schema edit rename a type across the whole data layer.

-- A card, wallet or account, named by the user.
--
-- Never a card number, and there is nowhere to put one: two text fields, one of
-- which is a glyph key. The whole feature exists so a reminder can say *which*
-- card is about to be charged, and a nickname does that. Storing a PAN would
-- turn an offline, accountless app into something worth stealing.
CREATE TABLE paymentSourceRow (
    id          TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,

    -- Which mark to draw: CARD / BANK / WALLET / CONTACTLESS / CASH.
    glyph       TEXT NOT NULL,

    createdAt   INTEGER NOT NULL
) AS PaymentSourceRowData;

-- The shelves an item can sit on, and the reminder defaults that come with
-- each one.
--
-- A table rather than an enum because the user adds their own. Everything the
-- app used to decide by switching on a five-value `Category` is a column here
-- instead: the app no longer knows any shelf by name, so a shelf someone
-- invents behaves exactly like a shipped one.
--
-- The shipped rows are seeded on create and on upgrade to v6. `builtIn` marks
-- them so the manager can refuse to delete a shelf the catalogue still points
-- at, and nothing else reads it.
CREATE TABLE categoryRow (
    id                TEXT NOT NULL PRIMARY KEY,

    -- What the user reads. Editable, including on the shipped rows: someone
    -- who calls it "Phim" should see "Phim".
    label             TEXT NOT NULL,

    -- The mark to draw beside the label, or NULL to work it out from the
    -- item's own name the way an uncategorised item already does.
    iconName          TEXT,

    -- DUE or EXPIRES. Whether a date on this shelf reads as money owed or as
    -- permission running out. Not derivable: a prepaid SIM is paid for and
    -- still expires.
    wording           TEXT NOT NULL,

    -- NONE / WEEKLY / DAILY, after the date has passed. Also decides whether a
    -- notification is time sensitive: anything that nags is a deadline, and a
    -- deadline delivered silently during Focus was not delivered.
    nag               TEXT NOT NULL,

    -- Comma-separated ints, same shape as itemRow.leadDays. The lead times a
    -- new item on this shelf starts with.
    leadDays          TEXT NOT NULL,

    -- How often to ask the user to re-check the date, or NULL for never. Only
    -- for dates the app cannot see drift: a passport office moves an
    -- appointment and nothing tells the phone.
    verifyEveryDays   INTEGER,

    -- Whether an amount on this shelf is spending. FALSE for the paperwork
    -- shelves: a passport fee is real money and still has no business in a
    -- monthly subscription total, because renewing one is not a recurring cost.
    countsTowardSpend BOOLEAN NOT NULL DEFAULT TRUE,

    builtIn           BOOLEAN NOT NULL DEFAULT FALSE,

    sortOrder         INTEGER NOT NULL
) AS CategoryRowData;

CREATE TABLE itemRow (
    id                TEXT NOT NULL PRIMARY KEY,
    name              TEXT NOT NULL,

    -- Which shelf this sits on: an id from categoryRow. The item's one and
    -- only classification; there is no second axis beside it.
    --
    -- No ON DELETE clause because the manager never deletes a shelf out from
    -- under an item -- it makes the user say where those items go first, and
    -- moves them in the same transaction.
    category          TEXT NOT NULL REFERENCES categoryRow(id),

    -- The key of a chosen icon. NULL means "work it out from the name", which
    -- is the normal state; a value here is an override the user made.
    iconName          TEXT,

    expiresOn         TEXT NOT NULL,
    actByOffsetDays   INTEGER NOT NULL DEFAULT 0,
    anchorDate        TEXT NOT NULL,
    cycle             TEXT,

    -- Total number of occurrences, or NULL for "forever". Only meaningful
    -- alongside a cycle. Which payment is due now is derived from anchorDate,
    -- never stored, so a re-recorded payment cannot desynchronise a counter.
    repeatCount       INTEGER,

    amountMinor       INTEGER,
    currency          TEXT,

    actionUrl         TEXT,
    actionLabel       TEXT,
    note              TEXT,

    -- Comma-separated ints; a child table would buy nothing for a handful of values.
    leadDays          TEXT NOT NULL,
    remindAt          TEXT NOT NULL,
    nagAfterDue       TEXT NOT NULL,

    verifyEveryDays   INTEGER,
    lastVerifiedAt    TEXT,
    dateSource        TEXT NOT NULL,

    -- One extra reminder the user asked for. Cleared once the occurrence is
    -- handled, so a stale snooze cannot outlive what it was postponing.
    snoozedUntil      TEXT,

    state             TEXT NOT NULL,

    -- The day a free trial began, or NULL for an item that is being paid for.
    --
    -- The trial's *end* is not stored: it is expiresOn, because the day the
    -- free period ends is the day the first charge lands. Storing both would
    -- let them disagree, and every reminder in the app already fires ahead of
    -- expiresOn -- which is exactly the promise a trial reminder makes.
    trialStart        TEXT,

    -- Which card or account pays for this, or NULL for "not said".
    --
    -- ON DELETE SET NULL rather than CASCADE: forgetting which card pays for
    -- Netflix must never delete Netflix. Requires PRAGMA foreign_keys = ON,
    -- which beforeOpen sets.
    paymentSourceId   TEXT REFERENCES paymentSourceRow(id) ON DELETE SET NULL,

    -- Turned off by the user: no reminders, and hidden from Upcoming. Not the
    -- same as any ItemState value -- a paused item is still tracked and still
    -- counts in Spending, it has just been told to be quiet. Orthogonal on
    -- purpose, so a cancelled-but-still-running subscription can also be
    -- muted.
    paused            BOOLEAN NOT NULL DEFAULT FALSE,

    -- What the user decided about the "this costs less yearly" suggestion:
    -- NULL / REMIND / SKIPPED.
    --
    -- One column with three states rather than two booleans, because there are
    -- three answers and only one of them can be true: not asked yet, remind me,
    -- and stop suggesting it. Two flags would allow a fourth state that means
    -- nothing.
    yearlyChoice      TEXT,

    -- Where the user bought it: UNKNOWN / WEB / APP_STORE / PLAY_STORE.
    -- Decides which page can actually show them this subscription. Defaults to
    -- UNKNOWN because the app never asks up front; the first tap answers it.
    purchaseChannel   TEXT NOT NULL DEFAULT 'UNKNOWN',

    createdAt         INTEGER NOT NULL
) AS ItemRowData;

CREATE INDEX item_expiresOn ON itemRow(expiresOn);
CREATE INDEX item_paymentSourceId ON itemRow(paymentSourceId);
CREATE INDEX item_state ON itemRow(state);
CREATE INDEX item_category ON itemRow(category);

-- Append-only. A row here is a thing that already happened, so nothing in it is
-- ever updated except actualChargedMinor, which the user types off a bank
-- statement.
--
-- The FX rate is snapshotted per row and never recomputed. Wallos stores one
-- mutable rate per currency and overwrites it every six hours, so every
-- historical figure in that app changes four times a day; that is the single
-- largest cluster of bugs in the project. IAS 21 agrees: a settled foreign
-- currency expense is recorded at the rate on the transaction date and is not
-- retranslated. See product-spec.md section 6.3.

CREATE TABLE handledEventRow (
    id                   TEXT NOT NULL PRIMARY KEY,
    itemId               TEXT NOT NULL REFERENCES itemRow(id) ON DELETE CASCADE,
    handledAt            INTEGER NOT NULL,
    forDueDate           TEXT NOT NULL,

    amountMinor          INTEGER,
    currency             TEXT,

    fxRateScaled         INTEGER,
    fxRateScale          INTEGER,
    fxRateDate           TEXT,
    fxSource             TEXT,
    baseAmountMinor      INTEGER,

    -- Typed off a statement. Overrides every computed figure when present, and
    -- is the only way to capture the bank's foreign-currency fee (Vietcombank
    -- charges 2.27%, so a computed figure is structurally low).
    actualChargedMinor   INTEGER
) AS HandledEventRowData;

CREATE INDEX handledEvent_itemId ON handledEventRow(itemId);
CREATE UNIQUE INDEX handledEvent_occurrence ON handledEventRow(itemId, forDueDate);

-- Key-value, one row per setting. A column-per-setting table would need a
-- migration for every preference the app grows, and there is only ever one row
-- of it; the shape that fits is a dictionary.

-- Named `settingKey` rather than `key`: drift drops a column called `key`
-- from the generated data class, because `key` is taken on every Flutter
-- widget it might otherwise sit beside.
CREATE TABLE settingRow (
    settingKey   TEXT NOT NULL PRIMARY KEY,
    value        TEXT NOT NULL
) AS SettingRowData;

-- ---- categories ----

selectAllCategories:
SELECT * FROM categoryRow ORDER BY sortOrder ASC;

-- ---- payment sources ----

selectAllSources:
SELECT * FROM paymentSourceRow ORDER BY createdAt ASC;

-- ---- settings ----

selectAllSettings:
SELECT * FROM settingRow;

-- ---- items ----

selectAll:
SELECT * FROM itemRow ORDER BY expiresOn ASC;

selectActive:
SELECT * FROM itemRow WHERE state = 'ACTIVE' ORDER BY expiresOn ASC;

selectById:
SELECT * FROM itemRow WHERE id = :id;

-- ---- history ----

selectForItem:
SELECT * FROM handledEventRow WHERE itemId = :itemId ORDER BY forDueDate DESC;

selectOccurrence:
SELECT * FROM handledEventRow WHERE itemId = :itemId AND forDueDate = :forDueDate;

selectSince:
SELECT * FROM handledEventRow WHERE forDueDate >= :from ORDER BY forDueDate DESC;

